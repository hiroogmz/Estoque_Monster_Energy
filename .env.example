ADMIN_SENHA=MONSTER1234!

# 1 somente se o site estiver atrás de HTTPS (cookie só trafega criptografado)
COOKIE_SEGURO=0
# 1 só enquanto estiver editando o código (nunca em produção)
DEBUG=0
