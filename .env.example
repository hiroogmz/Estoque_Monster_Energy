# Copie este arquivo para ".env" (mesma pasta do app.py) e ajuste os valores.
# NUNCA envie o .env para o Drive, GitHub ou e-mail.

# Chave que assina o cookie de sessão. Gere uma com:
#   py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=4e259e4f21f00fd7e02189858f64a75bad6ef6a1272619286fd2b0a8c1ad0fe4

# Banco MySQL 
DB_HOST=127.0.0.1
DB_PORT=3306
